# Copy this file to .env for local runs. On Railway, set these as Project Variables instead.

# ===== MODE =====
# false = PAPER trading: virtual money, REAL live prices. No API keys needed.
# true  = REAL MONEY: real orders on Bitunix. Needs the API keys below.
REAL_MONEY=false
PAPER_BALANCE=100
PAPER_FEE_RATE=0.0006
PAPER_SLIPPAGE=0.0002

# ===== Bitunix API credentials (only needed when REAL_MONEY=true) =====
BITUNIX_API_KEY=
BITUNIX_API_SECRET=

# ===== Market =====
SYMBOL=SOLUSDT
MARGIN_COIN=USDT

# ===== Money management =====
MARGIN_FRACTION=0.5
TP_PCT=0.01
SL_PCT=0.005
LEVERAGE_LADDER=2,4,8,16,32,64

# ===== Strategy =====
# ema = EMA crossover, always has a direction, trades constantly
# smc = market structure + Fair Value Gaps + Order Blocks, waits for a setup
STRATEGY=ema

# --- SMC settings (only used when STRATEGY=smc) ---
SMC_TIMEFRAME=5m            # 1m 5m 15m 30m 1h 2h 4h ...
SMC_SWING=3                 # candles on each side to confirm a swing high/low
SMC_MIN_ZONE_PCT=0.0005     # ignore FVG/OB zones smaller than 0.05% of price
SMC_ZONE_MAX_AGE=80         # ignore zones older than this many candles
SMC_FIRST_TOUCH_ONLY=true   # only trade a zone the first time price returns to it
SMC_MIN_SCORE=1             # 1 = any single zone; 2 = needs FVG+OB overlap (or zone+sweep)
SMC_ENTRY_TOLERANCE=0.0003  # how far outside a zone still counts as "inside"
SMC_REFRESH_SECONDS=15      # how often candles are re-downloaded

# ===== Entry signal for STRATEGY=ema (price sampled once per SIGNAL_INTERVAL_SECONDS) =====
SIGNAL_INTERVAL_SECONDS=60
EMA_FAST=9
EMA_SLOW=21
POLL_INTERVAL_SECONDS=2

# ===== Operational =====
POSITION_POLL_SECONDS=3
POST_TRADE_PAUSE_SECONDS=5
LOG_LEVEL=INFO
STATE_FILE=bot_state.json
PAPER_TRADES_CSV=paper_trades.csv

# ===== Safety rails =====
# Stops opening new trades when balance falls this fraction below the starting balance.
# Set to 0 to disable (e.g. to watch a paper account all the way down).
MAX_DRAWDOWN_FRACTION=0.5
MIN_LIQUIDATION_BUFFER_MULTIPLE=2.0
